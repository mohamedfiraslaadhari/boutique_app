# Copiez ce fichier en .env et mettez votre vrai mot de passe PostgreSQL
DB_PASSWORD=votre_mot_de_passe

# Clé secrète (obligatoire pour garder les connexions) : générez-en une avec la commande
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=une_longue_chaine_aleatoire

# Production seulement : FLASK_DEBUG=0 désactive le mode debug ; HTTPS=1 protège les cookies
# FLASK_DEBUG=0
# HTTPS=1